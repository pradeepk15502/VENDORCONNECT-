# ---- copy to .env for local development ----
ENVIRONMENT=development
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-of-at-least-50-characters-xxxx
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgis://vc:vc_dev_pw@localhost:5432/vendorconnect
REDIS_URL=redis://localhost:6379/0
# JWT_SIGNING_KEY=  (defaults to DJANGO_SECRET_KEY; set separately in production)
# OTP_HMAC_KEY=     (defaults to DJANGO_SECRET_KEY; set separately in production)
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_PER_PHONE_PER_HOUR=5
# dev only: returns the OTP in the API response. Refused by prod settings.
OTP_DEV_ECHO=true
# console | msg91 | twilio (real adapters need credentials)
SMS_PROVIDER=console
REFRESH_COOKIE_SECURE=false
# web app (5173), admin app (5175)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5175
LOG_LEVEL=INFO
# json in staging/production
LOG_FORMAT=console
FRESHNESS_AGING_HOURS=12
FRESHNESS_STALE_HOURS=48
SEARCH_RADIUS_KM_DEFAULT=5
SEARCH_RADIUS_KM_MAX=25
# local (default, no AWS needed) | s3 (staging/production — see docs/DEPLOYMENT.md)
MEDIA_STORAGE_BACKEND=local
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=ap-south-1
# MEDIA_S3_SIGNED_URL_EXPIRY_SECONDS=3600
